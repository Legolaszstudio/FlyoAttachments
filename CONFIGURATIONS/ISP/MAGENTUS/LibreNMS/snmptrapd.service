#/etc/systemd/system/snmptrapd.service

[Unit]
Description=Simple Network Management Protocol (SNMP) Trap Daemon
After=network.target
Documentation=man:snmptrapd(8) man:snmptrapd.conf(5)

[Service]
Type=simple
# The command to start the daemon (foreground mode, correct MIBs)
ExecStart=/usr/sbin/snmptrapd -n -Lsd -f -M /opt/librenms/mibs:/opt/librenms/mibs/cisco -m +IF-MIB:SNMPv2-MIB:CISCO-SMI:CISCO-TC:CISCO-CONFIG-MAN-MIB:CISCO-SYSLOG-MIB

# Permissions to bind to Port 162
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
# This section allows the service to be enabled at boot
WantedBy=multi-user.target